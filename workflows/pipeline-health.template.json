{
  "name": "Email-to-CRM Pipeline Health",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "ee9a92af-e1aa-4d70-8e16-ba3baad3c8ee",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$filter",
              "value": "={{ 'receivedDateTime ge ' + $now.minus({days: 10}).toUTC().toISO() + ' and isDraft eq false' }}"
            },
            {
              "name": "$select",
              "value": "id,receivedDateTime,from,subject,isDraft,parentFolderId"
            },
            {
              "name": "$orderby",
              "value": "receivedDateTime asc"
            },
            {
              "name": "$top",
              "value": "500"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "63e47fea-b068-40b8-b190-9966325615b6",
      "name": "List Mailbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "",
          "name": "Microsoft Outlook account"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "__SRC__:Pipeline_Health.js"
      },
      "id": "22490861-3dc4-422f-aadf-1bd033c7236d",
      "name": "Pipeline Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "toRecipients": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "bodyContent": "={{ $json.body }}",
        "additionalFields": {}
      },
      "id": "b0d6e9a2-6b49-4f85-aeff-f4cb62be8e74",
      "name": "Send Alert",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "",
          "name": "Microsoft Outlook account"
        }
      }
    }
  ],
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "List Mailbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Mailbox": {
      "main": [
        [
          {
            "node": "Pipeline Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pipeline Health": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
